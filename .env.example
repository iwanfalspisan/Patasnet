# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# DATABASE UTAMA: GOOGLE SHEETS & GOOGLE DRIVE (SIAP HOSTING VERCEL)
# ============================================================================
# Masukkan URL Web App Google Apps Script Anda (berakhiran /exec)
# Di Vercel Dashboard -> Settings -> Environment Variables, tambahkan:
# Key  : VITE_GOOGLE_SHEETS_URL
# Value: https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEETS_URL=""
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_DRIVE_FOLDER_NAME="PatasNet_Drive"
